<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Albums – Kuvasivu</title>
    <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>
    <header>
        <nav><a href="/">Kuvasivu</a></nav>
    </header>
    <main>
        
<h1>Albums</h1>

<div class="album-grid">
    
    <a href="/album/test-album" class="album-card">
        
        <picture>
            <img src="/thumbs/test-album/small/photo-a.jpg" srcset="/thumbs/test-album/small/photo-a.jpg 1x, /thumbs/test-album/medium/photo-a.jpg 2x" alt="Test Album" loading="lazy">
        </picture>
        
        <div class="album-info">
            <h2>Test Album</h2>
            
            <p class="timespan">January 2024</p>
            
        </div>
    </a>
    
</div>


    </main>
    
    <footer class="powered-by">
        <a href="https://github.com/miikka/kuvasivu/"><img src="/static/powered-by.svg" width="88" height="31" alt="Powered by kuvasivu"></a>
    </footer>
    
    
</body>
</html>
