    <link rel="stylesheet" href="/static/style.css">
</head>
<body>
    <header>
        <nav><a href="/">Kuvasivu</a></nav>
    </header>
    <main>
        
<h1>Test Album</h1>

<p class="timespan">January 2024</p>


<p class="description">A test album.</p>


<div class="photo-grid">
    
    <a href="/album/test-album/photo-a.jpg" class="photo-card">
        <picture>
            <source srcset="/thumbs/test-album/medium/photo-a.jpg.avif" type="image/avif">
            <img src="/thumbs/test-album/medium/photo-a.jpg" alt="photo-a.jpg" width="2048" height="1365" loading="lazy">
        </picture>
    </a>
    
    <a href="/album/test-album/photo-b.jpg" class="photo-card">
        <picture>
            <source srcset="/thumbs/test-album/medium/photo-b.jpg.avif" type="image/avif">
            <img src="/thumbs/test-album/medium/photo-b.jpg" alt="photo-b.jpg" width="2048" height="1365" loading="lazy">
        </picture>
    </a>
    
    <a href="/album/test-album/photo-c.jpg" class="photo-card">
        <picture>
            <source srcset="/thumbs/test-album/medium/photo-c.jpg.avif" type="image/avif">
            <img src="/thumbs/test-album/medium/photo-c.jpg" alt="photo-c.jpg" width="2048" height="1365" loading="lazy">
        </picture>
    </a>
    
</div>

    </main>
    
    <footer class="powered-by">
