---
source: tests/main_tests.rs
expression: body
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>photo-c.jpg – Test Album – Kuvasivu</title>
    <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/static/style.css">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Kuvasivu">
    <meta property="og:title" content="Test Album">
    <meta property="og:description" content="A test album.">
    <meta name="description" content="A test album.">
</head>
<body class="photo-page">
    <header>
        <nav><a href="/">Kuvasivu</a></nav>
    </header>
    <main>
        
<div class="photo-viewer">
    <div class="photo-topbar">
        <a href="/album/test-album" class="photo-back">&larr; Test Album</a>
        
        <span class="photo-exif">FUJIFILM X-T5 · Fujifilm Fujinon XF18mmF1.4 R LM WR · 18 mm  ƒ/5.6  1/280s  ISO 125</span>
        
    </div>

    <div class="photo-stage">
        <a href="/album/test-album/photo-b.jpg" class="photo-nav photo-nav-prev" aria-label="Previous photo">&lsaquo;</a>

        <div class="photo-main" data-thumb="/thumbs/test-album/medium/photo-c.jpg">
            <picture>
                <img src="/photos/test-album/photo-c.jpg" srcset="/thumbs/test-album/medium/photo-c.jpg 1200w, /thumbs/test-album/screen/photo-c.jpg 2048w" sizes="100vw" alt="photo-c.jpg">
            </picture>
        </div>

        <a  class="photo-nav photo-nav-next photo-nav-disabled" aria-label="Next photo">&rsaquo;</a>
    </div>
</div>

<script>
(function() {
    // Photo pages by URL, as promises of what's needed to show them, and the
    // ones that have loaded. Only the current photo and its neighbours are
    // kept, so phones don't run out of memory holding decoded photos.
    var pages = {};
    var loaded = {};
    var currentUrl = location.href;
    // The page being navigated to, until its photo is shown.
    var pendingUrl = null;
    var stage = document.querySelector('.photo-stage');
    var prevLink = document.querySelector('.photo-nav-prev');
    var nextLink = document.querySelector('.photo-nav-next');
    var exifSpan = document.querySelector('.photo-exif');
    var topbar = document.querySelector('.photo-topbar');

    function absolute(href) {
        return href ? new URL(href, location.href).href : null;
    }

    // Reads what's needed to show a photo page from its HTML.
    function readPage(doc) {
        var main = doc.querySelector('.photo-main');
        var img = main && main.querySelector('img');
        if (!img) return null;
        var source = main.querySelector('source');
        var exif = doc.querySelector('.photo-exif');
        var alt = img.getAttribute('alt') || '';
        return {
            title: doc.title,
            prev: absolute(doc.querySelector('.photo-nav-prev').getAttribute('href')),
            next: absolute(doc.querySelector('.photo-nav-next').getAttribute('href')),
            exif: exif && exif.textContent,
            image: {
                src: img.getAttribute('src'),
                srcset: img.getAttribute('srcset'),
                avifSrcset: source && source.getAttribute('srcset'),
                alt: alt
            },
            thumb: { src: main.dataset.thumb, avifSrcset: main.dataset.thumbAvif, alt: alt }
        };
    }

    // Builds a <picture> like the server renders. The <img> gets its sources
    // last, so the browser picks one only once the AVIF <source> is in place.
    function buildPicture(image) {
        var picture = document.createElement('picture');
        if (image.avifSrcset) {
            var source = document.createElement('source');
            source.type = 'image/avif';
            source.sizes = '100vw';
            source.srcset = image.avifSrcset;
            picture.appendChild(source);
        }
        var img = document.createElement('img');
        img.alt = image.alt;
        picture.appendChild(img);
        if (image.srcset) {
            img.sizes = '100vw';
            img.srcset = image.srcset;
        }
        img.src = image.src;
        return picture;
    }

    // Loads and decodes a picture's photo, so showing it doesn't stall. If
    // it fails to load, it resolves anyway: the browser shows what it can.
    function decodePicture(picture) {
        var img = picture.querySelector('img');
        var decoded = img.decode ? img.decode() : new Promise(function(resolve) {
            img.onload = img.onerror = resolve;
        });
        return decoded.catch(function() {});
    }

    function loadPage(url) {
        if (pages[url]) return pages[url];
        var promise = fetch(url).then(function(r) {
            if (!r.ok) throw new Error(r.status);
            return r.text();
        }).then(function(html) {
            var page = readPage(new DOMParser().parseFromString(html, 'text/html'));
            if (!page) throw new Error('not a photo page');
            page.picture = buildPicture(page.image);
            page.ready = decodePicture(page.picture).then(function() { page.decoded = true; });
            if (pages[url] === promise) loaded[url] = page;
            return page;
        });
        promise.catch(function() {
            if (pages[url] === promise) delete pages[url];
        });
        pages[url] = promise;
        return promise;
    }

    // Preloads two photos each way, so quick taps don't outrun loading.
    function preloadAround(url) {
        ['next', 'prev'].forEach(function(dir) {
            var first = loaded[url][dir];
            if (!first) return;
            loadPage(first).then(function(page) {
                if (page[dir] && currentUrl === url) loadPage(page[dir]);
            });
        });
    }

    // Forgets pages more than two photos away from the current one.
    function prune() {
        var keep = {};
        ['prev', 'next'].forEach(function(dir) {
            var url = currentUrl;
            for (var i = 0; i <= 2 && url; i++) {
                keep[url] = true;
                url = loaded[url] && loaded[url][dir];
            }
        });
        Object.keys(pages).forEach(function(url) {
            if (!keep[url]) {
                delete pages[url];
                delete loaded[url];
            }
        });
    }

    function showPicture(picture) {
        var shown = stage.querySelector('.photo-main picture');
        if (shown !== picture) shown.replaceWith(picture);
    }

    function updateNav(linkEl, href) {
        if (href) {
            linkEl.setAttribute('href', href);
            linkEl.classList.remove('photo-nav-disabled');
        } else {
            linkEl.removeAttribute('href');
            linkEl.classList.add('photo-nav-disabled');
        }
    }

    function updateExif(text) {
        if (text && exifSpan) {
            exifSpan.textContent = text;
        } else if (text && !exifSpan) {
            exifSpan = document.createElement('span');
            exifSpan.className = 'photo-exif';
            exifSpan.textContent = text;
            topbar.appendChild(exifSpan);
        } else if (!text && exifSpan) {
            exifSpan.remove();
            exifSpan = null;
        }
    }

    function finish(page) {
        showPicture(page.picture);
        stage.classList.remove('photo-loading');
        pendingUrl = null;
    }

    function navigateTo(url, push) {
        if (!url || url === (pendingUrl || currentUrl)) return;
        pendingUrl = url;
        stage.classList.add('photo-loading');
        loadPage(url).then(function(page) {
            if (pendingUrl !== url) return;
            // Update the page right away, so the next tap can follow.
            currentUrl = url;
            updateNav(prevLink, page.prev);
            updateNav(nextLink, page.next);
            updateExif(page.exif);
            if (push) history.pushState(null, '', url);
            document.title = page.title;
            prune();
            preloadAround(url);

            if (page.decoded) {
                finish(page);
                return;
            }
            // Until the photo is ready, show its medium thumbnail, which the
            // album page has usually loaded already.
            var thumb = buildPicture(page.thumb);
            decodePicture(thumb).then(function() {
                if (pendingUrl === url && !page.decoded) showPicture(thumb);
            });
            page.ready.then(function() {
                if (pendingUrl === url) finish(page);
            });
        }, function() {
            window.location = url;
        });
    }

    var initial = readPage(document);
    initial.picture = document.querySelector('.photo-main picture');
    initial.decoded = true;
    initial.ready = Promise.resolve();
    pages[currentUrl] = Promise.resolve(initial);
    loaded[currentUrl] = initial;

    prevLink.addEventListener('click', function(e) {
        if (this.hasAttribute('href')) { e.preventDefault(); navigateTo(this.href, true); }
    });
    nextLink.addEventListener('click', function(e) {
        if (this.hasAttribute('href')) { e.preventDefault(); navigateTo(this.href, true); }
    });

    window.addEventListener('popstate', function() {
        navigateTo(location.href, false);
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowLeft' && prevLink.hasAttribute('href')) {
            navigateTo(prevLink.href, true);
        } else if (e.key === 'ArrowRight' && nextLink.hasAttribute('href')) {
            navigateTo(nextLink.href, true);
        } else if (e.key === 'Escape') {
            e.preventDefault();
            window.location.href = document.querySelector('.photo-back').href;
        }
    });

    preloadAround(currentUrl);
})();
</script>

    </main>
    
    
</body>
</html>
